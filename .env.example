# Copy to .env and fill in. .env is gitignored — never commit the real key.
# Register a free key at https://developer.pubg.com (use a PERSONAL email).
PUBG_API_KEY=

# steam | psn | xbox | kakao
PUBG_SHARD=steam

# Where raw data lands. Keep off any work volume.
PUBG_DATA_DIR=./data

# Metered endpoints only (/samples, /players, /seasons).
# /matches and telemetry downloads are exempt from the API rate limit.
PUBG_RPM=10

# Concurrent downloads for the exempt endpoints.
PUBG_CONCURRENCY=8
